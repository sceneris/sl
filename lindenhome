<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Interiors Showcase</title>
    <style>
        body {
            background-color: #121212;
            color: #ffffff;
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        /* Navigation Bar */
        nav {
            display: flex;
            gap: 20px;
            margin-bottom: 30px;
            border-bottom: 1px solid #333;
            padding-bottom: 15px;
            width: 100%;
            max-width: 800px;
            justify-content: center;
        }
        nav a {
            color: #888;
            text-decoration: none;
            font-size: 1.1rem;
        }
        nav a:hover, nav a.active {
            color: #fff;
            font-weight: bold;
        }

        /* Video Showcase Wrapper */
        .showcase-container {
            width: 100%;
            max-width: 800px;
        }

        /* Individual Video Item */
        .video-item {
            margin-bottom: 40px;
            background: #1a1a1a;
            border-radius: 8px;
            padding: 20px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.5);
        }

        .video-title {
            margin: 0 0 5px 0;
            font-size: 1.3rem;
            font-weight: 500;
        }

        .video-subtitle {
            margin: 0 0 15px 0;
            color: #aaa;
            font-size: 0.95rem;
            line-height: 1.4;
        }

        /* Responsive 16:9 Video Frame */
        .embed-container {
            position: relative;
            padding-bottom: 56.25%; /* 16:9 Aspect Ratio */
            height: 0;
            overflow: hidden;
            border-radius: 6px;
            background: #000;
        }
        .embed-container iframe {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            border: 0;
        }
    </style>
</head>
<body>

    <!-- CATEGORY NAVIGATION -->
    <nav>
        <a href="index.html">Architecture</a>
        <a href="interiors.html" class="active">Interiors</a>
        <a href="landscapes.html">Landscapes</a>
    </nav>

    <div class="showcase-container">

        <!-- VIDEO ITEM 1 -->
        <div class="video-item">
            <h2 class="video-title">Traditional</h2>
            <p class="video-subtitle">Custom mesh lighting, open-plan spatial design, and muted neutral textures.</p>
            
            <div class="embed-container">
                <iframe src="https://youtube.com/SStJDtXXHuA" 
                        title="Modern Minimalist Loft" 
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                        allowfullscreen>
                </iframe>
            </div>
        </div>

        <!-- VIDEO ITEM 2 -->
        <div class="video-item">
            <h2 class="video-title">Camper</h2>
            <p class="video-subtitle">High-contrast neon accent lighting paired with industrial metallic decor components.</p>
            
            <div class="embed-container">
                <iframe src="https://youtube.com/k4GTpF8rDZg" 
                        title="Cyberpunk Apartment Showcase" 
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                        allowfullscreen>
                </iframe>
            </div>
        </div>

    </div>

</body>
</html>
